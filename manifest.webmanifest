{
  "name": "DigitBot",
  "short_name": "DigitBot",
  "description": "DigitBot: MMG digit bot, Forex & Crypto charts, signals, backtests and practice trading, Screen Trader.",
  "id": "./",
  "start_url": "./index.html?app=1",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "categories": ["finance", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Crypto", "url": "./trade.html#crypto", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Forex", "url": "./trade.html#forex", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "MMG digit bot", "url": "./mmg.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Screen Trader", "url": "./screen.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Settings", "url": "./settings.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
